# Copy this file's values into your MCP client's config (Claude Desktop,
# Claude Code, etc.) — see README.md. This file itself is never read
# automatically; it exists purely as a reference for what to set.

# Required. Your Wasi Hub API key — get one from the "API Keys" page inside
# your Wasi account (Settings > Developer), or from your Wasi admin.
# Treat this exactly like a password: never commit it, never share it, never
# paste it into a chat with an AI assistant asking you to "confirm" it.
WASI_API_KEY=

# Required. The base URL of your Wasi instance (no trailing slash).
WASI_API_BASE_URL=https://your-wasi-domain.example
