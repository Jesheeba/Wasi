{
  "name": "n8n-nodes-wasi",
  "version": "0.1.0",
  "description": "n8n community node for Wasi's WhatsApp Business Hub API (send messages, templates, contacts, conversations, webhooks)",
  "keywords": [
    "n8n-community-node-package",
    "whatsapp",
    "wasi"
  ],
  "license": "MIT",
  "homepage": "https://wasi.sirahagents.com",
  "author": {
    "name": "Sirah Digital"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sirahdigital/n8n-nodes-wasi"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && npx copyfiles -u 0 \"nodes/**/*.{png,svg}\" dist",
    "dev": "tsc --watch",
    "lint": "eslint nodes credentials --ext .ts"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/WasiApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Wasi/Wasi.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/parser": "^8.72.2",
    "copyfiles": "^2.4.1",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.1",
    "n8n-workflow": "^1.63.0",
    "typescript": "^5.5.4"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
