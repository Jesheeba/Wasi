{
  "id": "wasi-hub-api-env-template",
  "name": "Wasi Hub API - Template (fill in your own values)",
  "values": [
    {
      "key": "base_url",
      "value": "https://your-wasi-deployment.example.com",
      "type": "default",
      "enabled": true
    },
    {
      "key": "api_key",
      "value": "wasi_replace_with_your_hub_api_key",
      "type": "secret",
      "enabled": true
    },
    {
      "key": "client_id",
      "value": "00000000-0000-0000-0000-000000000000",
      "type": "default",
      "enabled": true
    },
    {
      "key": "admin_token",
      "value": "replace_with_an_admin_jwt_from_POST_/api/admin/auth/login",
      "type": "secret",
      "enabled": true
    },
    {
      "key": "client_token",
      "value": "replace_with_a_client_jwt_from_POST_/api/auth/login",
      "type": "secret",
      "enabled": true
    },
    {
      "key": "api_key_id",
      "value": "replace_with_an_api_key_row_id_to_revoke_or_delete",
      "type": "default",
      "enabled": true
    }
  ],
  "_postman_variable_scope": "environment"
}
