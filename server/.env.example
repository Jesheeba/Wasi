PORT=4000
NODE_ENV=development
DATABASE_URL=postgres://crm:crm_dev_pw@localhost:5432/crm_dev

# Required for ANY test that touches the database (node --test sets
# NODE_TEST_CONTEXT, which src/utils/dbSafety.js checks). With no
# TEST_DATABASE_URL set, every DB-touching test refuses to run — on purpose:
# this project's main DATABASE_URL is the same Supabase instance as
# production, and a test run must never reach it, even with
# ALLOW_SHARED_PRODUCTION_DB (that override is NOT honored under a test
# context). TEST_DATABASE_URL must point at a real, separate database — a
# local Postgres 17 (pin 17; production is 17, not a newer major) is the
# simplest option:
#   docker run -d --name wasi-test-postgres -p 5433:5432 \
#     -e POSTGRES_USER=wasi_test -e POSTGRES_PASSWORD=wasi_test_pw \
#     -e POSTGRES_DB=wasi_test postgres:17-alpine
# Setting TEST_DATABASE_URL alone only satisfies dbSafety's presence check —
# src/db/pool.js always connects using DATABASE_URL, so to actually run tests
# against this database, override BOTH for that invocation (do not put the
# local value in DATABASE_URL above; that would repoint the dev server too):
#   DATABASE_URL="postgres://wasi_test:wasi_test_pw@localhost:5433/wasi_test" \
#   TEST_DATABASE_URL="$DATABASE_URL" npx node-pg-migrate up -m src/db/migrations
#   DATABASE_URL="postgres://wasi_test:wasi_test_pw@localhost:5433/wasi_test" \
#   TEST_DATABASE_URL="$DATABASE_URL" node src/db/seed.js
#   DATABASE_URL="postgres://wasi_test:wasi_test_pw@localhost:5433/wasi_test" \
#   TEST_DATABASE_URL="$DATABASE_URL" npm test
# TEST_DATABASE_URL=postgres://wasi_test:wasi_test_pw@localhost:5433/wasi_test

# Base URL this app is served at — used to build links in password
# reset/email verification emails. Same-origin production deploy: your
# public URL (e.g. https://your-app.onrender.com). Local dev default matches
# `npm start`'s static server port.
APP_URL=http://localhost:3000

# Comma-separated list of origins allowed to call the API from a browser.
# Only needed for split-origin setups (local dev: :3000 -> :4000). Same-origin
# production requests (the norm — see server/src/app.js static mounts) don't
# need an entry here at all.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# When DATABASE_URL points at a hosted Postgres (Supabase, Render, etc. —
# anything not localhost/127.0.0.1), src/db/pool.js enables TLS automatically.
# Some poolers (e.g. Supabase's Supavisor) present a cert chain Node's default
# trust store rejects; this makes node-pg-migrate (which pool.js's ssl option
# doesn't cover) use the same "encrypt but don't verify" mode. Leave unset for
# local Postgres.
# PGSSLMODE=no-verify

# Fixed UUID for the demo tenant created by `npm run db:seed`.
DEV_CLIENT_ID=00000000-0000-0000-0000-000000000001

# --- Auth ---
# Any long random string. Rotate for real deployments — never reuse the dev value.
JWT_SECRET=dev-only-change-me-jwt-secret

# --- Secret storage (MVP AES key for wabas.access_token_encrypted; NOT real KMS/Vault) ---
SERVER_SECRET=dev-only-change-me-server-secret

# --- Meta / WhatsApp Embedded Signup + Cloud API messaging ---
# Create a Meta App with the WhatsApp product + Embedded Signup config to get these.
# Nothing WhatsApp-related works until these are real.
META_APP_ID=
# Placeholder for local test runs only, NOT a real secret. metaWebhook.js's
# verifySignature() hard-rejects (401, "Invalid webhook signature") any
# request when this is blank, and the test suite computes its own HMAC using
# this same env var against simulated (never real Meta) payloads — both
# sides just need to agree on a non-empty value. Replace with your real Meta
# App Secret for anything that actually needs to verify a genuine webhook
# from Meta.
META_APP_SECRET=dev-only-change-me-app-secret
META_CONFIG_ID=
META_GRAPH_API_VERSION=v21.0
META_WEBHOOK_VERIFY_TOKEN=dev-only-change-me-webhook-token

# --- Razorpay billing ---
# From your Razorpay dashboard. Nothing payment-related works until these are real.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Transactional email (password reset, verification, admin invites) ---
RESEND_API_KEY=
EMAIL_FROM=Wasi CRM <noreply@yourdomain.com>

# --- Phase 6 alerting (server/src/services/alertRunner.js) ---
# Where alert emails and the daily digest go. Without this set, alerts are
# only logged to the console (same degrade-gracefully pattern as
# RESEND_API_KEY above) — set this before relying on alerting in production.
ALERT_EMAIL_TO=
# Optional secondary channel — both must be set for WhatsApp alerts to send,
# and a pre-approved 'wasi_ops_alert' Utility template must already exist on
# the WABA below (see alertNotifier.js). Left unset, WhatsApp alerting is
# silently skipped and email is the only channel.
ALERT_WHATSAPP_TO=
ALERT_WABA_ID=

# --- Payment reminder / auto-suspend (server/src/services/paymentReminderRunner.js) ---
# Must point at a WABA Wasi itself controls — NOT a borrowed client's WABA
# like ALERT_WABA_ID above. This sends client-facing billing messages
# (payment reminders, suspension warnings/notices); a client seeing it arrive
# from another Wasi client's business identity is confusing at best and a
# quality-rating/policy risk to that uninvolved client at worst. See
# clientNotifier.js's module comment. Left unset, these sends are silently
# skipped (same degrade-gracefully pattern as every optional integration
# here) and the runner's audit_log/status-column side effects still happen.
# Also requires 3 pre-approved Utility templates to exist on that WABA:
# wasi_payment_reminder, wasi_suspension_warning, wasi_service_suspended.
PAYMENT_REMINDER_WABA_ID=
